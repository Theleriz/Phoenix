# Development-only credentials. Replace before every non-local deployment.
POSTGRES_DB=phoenix
POSTGRES_USER=phoenix_dev
POSTGRES_PASSWORD=change-me-local-only
MINIO_ROOT_USER=phoenix_minio_dev
MINIO_ROOT_PASSWORD=change-me-local-only
OLLAMA_HOST=0.0.0.0
API_AUTH_SECRET=change-me-local-only
PHOENIX_GATEWAY_TOKEN=change-me-local-only-gateway-token
# Dev-only. 1 = run the ML shadow branch even when signal quality is LOW.
PHOENIX_ML_FORCE_INFERENCE=0
# Dev-only: let patient-web ?hw=1 open a hardware gateway session bound to the
# demo episode without a linked-patient login. Keep 0 in prod.
PHOENIX_DEV_HARDWARE_SESSION=0
